#!/usr/bin/env python3
"""Executable entrypoint for running claude-subagent directly from a repo checkout."""

import os
import sys

_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
_SRC = os.path.join(_ROOT, "src")
if _SRC not in sys.path:
    sys.path.insert(0, _SRC)

from claude_subagent.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
